# Copy to .env and adjust. Every value is optional: the app runs with none of them set.
# Never commit .env. Placeholders only in this file.

# --- Host ports used by docker compose (change if already in use) ---
DB_PORT=5433
BACKEND_PORT=8000
FRONTEND_PORT=3000

# --- Database (only used when running the backend outside Docker) ---
DATABASE_URL=postgresql+psycopg://finance:finance@localhost:5433/finance
TEST_DATABASE_URL=postgresql+psycopg://finance:finance@localhost:5433/finance_test

# --- Paper trading ---
INITIAL_CASH=100000.00
# Simulated charges estimate per order: PAPER_FEE_PERCENT % of order value + PAPER_FEE_FLAT rupees.
PAPER_FEE_PERCENT=0.10
PAPER_FEE_FLAT=0.00

# --- Market data ---
# csv    = bundled simulated fixtures (default) or your own licensed EOD CSV files
# upstox = placeholder adapter, not implemented in this POC (see README)
MARKET_DATA_PROVIDER=csv
# Label for CSV data: SIMULATED for the bundled fixtures, HISTORICAL if you supply real EOD files.
CSV_DATA_STATUS=SIMULATED
UPSTOX_ACCESS_TOKEN=

# --- AI insights (optional) ---
# Without a key, insights use the deterministic rule-based explanations.
ANTHROPIC_API_KEY=
# Default is claude-opus-5-5. claude-haiku-5-5 is a much cheaper option for this short summary.
ANTHROPIC_MODEL=claude-opus-5-5
